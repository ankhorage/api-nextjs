      "area": "examples",
      "title": "Basic Usage",
      "description": "Create a framework-neutral API runtime and bind one operation to a Next.js App Router route\nhandler.",
      "language": "ts",
      "code": "const runtime = createApiRuntime({\n  definition: {\n    id: \"health-api\",\n    origin: \"internal\",\n    protocol: \"rest\",\n    basePath: \"/api\",\n    endpoints: {\n      health: {\n        id: \"health\",\n        kind: \"http\",\n        operations: {\n          \"health.read\": {\n            id: \"health.read\",\n            protocol: \"http\",\n            intent: \"read\",\n            method: \"GET\",\n            path: \"/health\",\n          },\n        },\n      },\n    },\n  },\n  handlers: {\n    \"health.read\": () => ({ body: { ok: true } }),\n  },\n});",
