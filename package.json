{
  "name": "@ankhorage/api-nextjs",
  "version": "0.0.0",
  "type": "module",
  "description": "Next.js App Router transport adapter for @ankhorage/api.",
  "license": "MIT",
  "repository": {"type":"git","url":"git+https://github.com/ankhorage/api-nextjs.git"},
  "homepage": "https://github.com/ankhorage/api-nextjs#readme",
  "bugs": {"url":"https://github.com/ankhorage/api-nextjs/issues"},
  "keywords": ["ankhorage","api","nextjs","app-router","adapter","typescript"],
  "sideEffects": false,
  "files": ["dist","README.md","CHANGELOG.md","LICENSE"],
  "exports": {
    ".": {"types":"./dist/apiNextjs.d.ts","import":"./dist/apiNextjs.js","default":"./dist/apiNextjs.js"},
    "./package.json": "./package.json"
  },
  "publishConfig": {"access":"public"},
  "engines": {"node":">=24","bun":">=1.2.18"},
  "scripts": {
    "build":"rm -rf dist tsconfig.tsbuildinfo && bun x tsc -p tsconfig.build.json",
    "changeset":"ankhorage-changeset",
    "changeset:status":"ankhorage-changeset status --since=origin/main",
    "docs":"paradox",
    "format":"ankhorage-prettier --write .",
    "format:check":"ankhorage-prettier --check .",
    "lint":"ankhorage-eslint . --max-warnings=0",
    "lint:fix":"ankhorage-eslint . --fix --max-warnings=0",
    "prepack":"bun run build",
    "test":"bun test src",
    "typecheck":"bun x tsc --noEmit -p tsconfig.json",
    "version-packages":"ankhorage-changeset version",
    "knip:check":"ankhorage-knip"
  },
  "dependencies":{"@ankhorage/api":"^0.1.0"},
  "peerDependencies":{"next":">=15 <17"},
  "devDependencies":{
    "@ankhorage/devtools":"^2.1.11",
    "@ankhorage/paradox":"^0.2.28",
    "@types/bun":"^1.4.2",
    "@types/node":"^26.6.4",
    "next":"^16.3.8",
    "typescript":"~6.0.3"
  },
  "packageManager":"bun@1.4.2"
}
